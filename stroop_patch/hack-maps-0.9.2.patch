+    // A romhack's map set (Config/MapAssociations.xml <MapHack>): recognised by words of its RAM (Signature), its
+    // maps carry hack="<name>". Added by the stroopmaps patch so that "Recommended" can pick them.
+    public class MapHack
+    {
+        public string Name;
+        public string Prefer;   // the map kind to prefer when the hack has several ("textured" or "collision")
+        public List<(uint address, uint mask, uint value)> Signature = new List<(uint, uint, uint)>();
+
+        public bool Matches()
+        {
+            if (Signature.Count == 0) return false;
+            foreach (var (address, mask, value) in Signature)
+                if ((Config.Stream.GetUInt32(address) & mask) != value) return false;
+            return true;
+        }
+    }
+
     public class MapAssociations
