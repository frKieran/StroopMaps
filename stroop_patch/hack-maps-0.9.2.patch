-                return ROMHackMap;
+            if (HackOverride == "off") return null;
+            if (!string.IsNullOrEmpty(HackOverride) && HackOverride != "auto")
+                return Hacks.Find(hack => hack.Name == HackOverride);
+            return Hacks.Find(hack => hack.Matches());
+        }
 
+        // The best map of a hack's set for this place, or null when the set has none here.
+        public MapLayout GetBestHackMap(MapHack hack, byte level, byte area, ushort loadingPoint, ushort missionLayout, float y)
+        {
+            List<MapLayout> mapList = GetLevelAreaMaps(level, area, loadingPoint, missionLayout);
+            mapList = mapList.FindAll(map => map.Hack == hack.Name && map.Y <= y);
+            if (hack.Prefer != null && mapList.Exists(map => map.Kind == hack.Prefer))
+                mapList = mapList.FindAll(map => map.Kind == hack.Prefer);
+            if (mapList.Count == 0) return null;
+            MapLayout bestMap = mapList.First();
+            foreach (MapLayout map in mapList)
+                if (map.Y > bestMap.Y) bestMap = map;
+            return bestMap;
+        }
+
+        public MapLayout GetBestMap()
+        {
             byte level = Config.Stream.GetByte(MiscConfig.WarpDestinationAddress + MiscConfig.LevelOffset);
             byte area = Config.Stream.GetByte(MiscConfig.WarpDestinationAddress + MiscConfig.AreaOffset);
             ushort loadingPoint = Config.Stream.GetUInt16(MiscConfig.LoadingPointAddress);
             ushort missionLayout = Config.Stream.GetUInt16(MiscConfig.MissionAddress);
             float y = Config.Stream.GetSingle(MarioConfig.StructAddress + MarioConfig.YOffset);
+
+            MapHack activeHack = GetActiveHack();
+            if (activeHack != null)
+            {
+                MapLayout hackMap = GetBestHackMap(activeHack, level, area, loadingPoint, missionLayout, y);
+                if (hackMap != null) return hackMap;
+            }
+
+            bool isRomHack = Config.Stream.GetUInt32(0x80402000) != 0;
+            if (isRomHack)
+                return ROMHackMap;
+
             return GetBestMap(level, area, loadingPoint, missionLayout, y);
         }
 
